# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ──────────────────────────────────────────────
# Aiven Cloud MySQL
# ──────────────────────────────────────────────
MYSQL_HOST=mysql-xxxxxxxx-yourproject.c.aivencloud.com
MYSQL_PORT=28314
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_mysql_password_here
MYSQL_SSL_CA=./certs/ca.pem

# ──────────────────────────────────────────────
# Firebase Admin SDK
# ──────────────────────────────────────────────
# Path to the downloaded Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./certs/firebase-service-account.json

# Alternative: Inline credentials (if service account file is not used)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────
# JWT / Auth
# ──────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

