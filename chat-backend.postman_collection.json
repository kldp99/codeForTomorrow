            "url": { "raw": "{{baseUrl}}/chat/create", "host": ["{{baseUrl}}"], "path": ["chat", "create"] }
          }
        },
        {
          "name": "11 – List chats for User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('chats is array', () => pm.expect(json.chats).to.be.an('array'));",
                  "pm.test('chat contains expected fields', () => {",
                  "  const c = json.chats[0];",
                  "  pm.expect(c).to.have.property('chatId');",
                  "  pm.expect(c).to.have.property('chatType');",
                  "  pm.expect(c).to.have.property('members');",
                  "  pm.expect(c).to.have.property('createdAt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/user/{{userAId}}/chats", "host": ["{{baseUrl}}"], "path": ["user", "{{userAId}}", "chats"] }
          }
        },
        {
          "name": "12 – List chats for non-existent user (expect 404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/user/00000000-0000-0000-0000-000000000099/chats",
              "host": ["{{baseUrl}}"],
              "path": ["user", "00000000-0000-0000-0000-000000000099", "chats"]
            }
          }
        }
      ]
    },
    {
      "name": "Messages (Phase 2)",
      "item": [
        {
          "name": "13 – Send valid message (Expect 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('messageId present', () => {",
                  "  pm.expect(json.messageId).to.be.a('string');",
                  "  pm.expect(json.data.messageId).to.equal(json.messageId);",
                  "  pm.collectionVariables.set('messageId', json.messageId);",
                  "});",
                  "pm.test('data contains expected fields', () => {",
                  "  pm.expect(json.data.chatId).to.equal(pm.collectionVariables.get('chatId'));",
                  "  pm.expect(json.data.senderId).to.equal(pm.collectionVariables.get('userAId'));",
                  "  pm.expect(json.data.text).to.equal('Hello Bob!');",
                  "  pm.expect(json.data.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"{{userAId}}\",\n  \"text\": \"Hello Bob!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/chat/{{chatId}}/message/send", "host": ["{{baseUrl}}"], "path": ["chat", "{{chatId}}", "message", "send"] }
