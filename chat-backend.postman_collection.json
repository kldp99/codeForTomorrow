        {
          "name": "25 – Mark message as read by valid member (Expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('isNew true on first read', () => pm.expect(json.data.isNew).to.be.true);",
                  "pm.test('readAt timestamp present', () => pm.expect(json.data.readAt).to.be.a('string'));",
                  "pm.test('userId matches User B', () => pm.expect(json.data.userId).to.equal(pm.collectionVariables.get('userBId')));",
                  "pm.collectionVariables.set('firstReadAt', json.data.readAt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userBId}}\"\n}"
