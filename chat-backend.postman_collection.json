          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userAId\": \"{{userAId}}\",\n  \"userBId\": \"00000000-0000-0000-0000-000000000099\"\n}"
